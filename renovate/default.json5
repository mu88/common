{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "mu88's default preset",
  "extends": [
    "config:recommended",
    "group:all",
    ":semanticCommitTypeAll(chore)"
  ],
  "logLevelRemap": [
    {
      "matchMessage": "*as they do not have a releaseTimestamp and we're running with minimumReleaseAgeBehaviour=timestamp-required*",
      "newLogLevel": "error"
    },
    {
      "matchMessage": "*Preset fetch error*",
      "newLogLevel": "error"
    },
    {
      "matchMessage": "*Repository has invalid config*",
      "newLogLevel": "error"
    },
    {
      "matchMessage": "*did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional*",
      "newLogLevel": "info"
    }
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 6-18 * * 1"
  ],
  "automergeSchedule": [
    "* 6-18 * * 1"
  ],
  "mode": "full",
  "automerge": true,
  "automergeType": "branch",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest",
    "schedule": [
      "at any time"
    ],
    "automergeSchedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      // Catch-all matching every package via wildcard (Renovate requires at least one match*/exclude* selector).
      // Placed first in user rules so it wins over any inherited preset packageRules
      // (e.g. security:minimumReleaseAgeNpm sets 3 days for npm).
      // More-specific rules below still take precedence because they appear later (last-match wins).
      "description": "Base minimumReleaseAge – guard against inherited-preset packageRule overrides",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Pin GitHub Actions to immutable commit SHAs",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      // Source: https://docs.renovatebot.com/key-concepts/minimum-release-age/#pindigest-updates
      "description": "Immediately pin GitHub Actions to their current immutable commit SHAs",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      // Workaround for renovatebot/renovate#45236: the branch-stage stability check reads
      // `upgrade.releaseTimestamp`, which Renovate never sets for digest updates (only the
      // lookup stage ages them, against the matching version's timestamp). Without this,
      // digest updates for moving tags (e.g. actions/setup-java@v6) stay pending forever
      // once they pass minimumReleaseAge, because the branch stage can't see the timestamp.
      "description": "Prevent the branch-stage stability check from permanently pending digest updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Bump bare NuGet versions to the latest release (see https://docs.renovatebot.com/modules/manager/nuget/#getting-updates-for-non-pinned-bare-versions)",
      "matchManagers": [
        "nuget"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Immediately merge updates of my own NuGet package as I'm in charge of those.",
      "matchPackageNames": [
        "mu88.Shared"
      ],
      "minimumReleaseAge": "0 minutes",
      "schedule": [
        "at any time"
      ],
      "automergeSchedule": [
        "at any time"
      ]
    },
    {
      "description": "Only sync mu88/common digest updates in a Monday-evening window, after the day's regular Renovate runs have settled, to batch same-day upstream commits into one downstream update",
      "matchDepNames": [
        "mu88/common"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": [
        "* 18-20 * * 1"
      ],
      "automergeSchedule": [
        "* 18-20 * * 1"
      ],
      "minimumReleaseAge": "0 minutes"
    },
    {
      "description": "Wait with non-major updates of .NET SDK and runtime (global.json and Docker images) so that it is likely to be installed on all dev machines, too",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchPackageNames": [
        "dotnet-sdk",
        "dotnet-runtime",
        "mcr.microsoft.com/dotnet/sdk",
        "mcr.microsoft.com/dotnet/aspnet",
        "mcr.microsoft.com/dotnet/runtime",
        "mcr.microsoft.com/dotnet/runtime-deps"
      ],
      "groupName": "all .NET",
      "groupSlug": "all-dotnet",
      "minimumReleaseAge": "21 days"
    },
    {
      "description": "Group .NET-cadence framework NuGet packages together with the .NET SDK and runtime updates so that they are shipped together",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.AspNetCore*",
        "Microsoft.EntityFrameworkCore*",
        "Microsoft.Extensions.*",
        "System.Text.Json"
      ],
      "groupName": "all .NET",
      "groupSlug": "all-dotnet",
      "minimumReleaseAge": "21 days"
    },
    {
      "description": "Group .NET SDK and runtime updates together with the dotnet-tools.json updates so that they are shipped together",
      "separateMajorMinor": false,
      "matchFileNames": [
        ".config/dotnet-tools.json"
      ],
      "groupName": "all .NET",
      "groupSlug": "all-dotnet",
      "minimumReleaseAge": "21 days"
    },
    {
      "description": "Major updates of .NET-cadence SDK/runtime and framework package families will be done manually",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "dotnet-sdk",
        "dotnet-runtime",
        "mcr.microsoft.com/dotnet/sdk",
        "mcr.microsoft.com/dotnet/aspnet",
        "mcr.microsoft.com/dotnet/runtime",
        "mcr.microsoft.com/dotnet/runtime-deps",
        "Microsoft.AspNetCore*",
        "Microsoft.EntityFrameworkCore*",
        "Microsoft.Extensions.*",
        "System.Text.Json"
      ],
      "enabled": false
    },
    {
      // Renovate has no native LibMan manager yet (we proposed one: https://github.com/renovatebot/renovate/discussions/46445).
      // Until that lands, the customManagers entry below resolves LibMan libraries via the npm datasource as an
      // approximation, since it cannot tell which LibMan "provider" (cdnjs/jsdelivr/unpkg) a given entry actually
      // uses - see that customManagers entry's own comment for why this is imprecise for cdnjs-provided libraries.
      // Force a manual review for every update coming out of that approximation instead of letting it auto-merge
      // unattended, since we have no correctness guarantee that the npm version we bump to actually exists at the
      // LibMan provider that will really be queried by "libman restore" in CI.
      "description": "Require manual review for LibMan libraries resolved via the npm-approximation customManagers regex (no automerge)",
      "matchFileNames": [
        "**/libman.json"
      ],
      "matchDatasources": [
        "npm"
      ],
      "automerge": false,
      "addLabels": [
        "libman-npm-approximation"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\S*\\.csproj$/"
      ],
      "matchStrings": [
        "<ContainerBaseImage>(?<packageName>\\S+):(?<currentValue>\\S+)<\/ContainerBaseImage>"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\S*\\.csproj$/"
      ],
      "matchStrings": [
        "<CustomContainerBaseImageVersion>(?<currentValue>\\S+)<\/CustomContainerBaseImageVersion>"
      ],
      "datasourceTemplate": "dotnet-version",
      "packageNameTemplate": "dotnet-runtime"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\S*\\.devcontainer\\/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "\"image\":\\s*\"\\S*mu88\\/devcontainers-dotnet\\S*:sdk-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\S*"
      ],
      "datasourceTemplate": "dotnet-version",
      "packageNameTemplate": "dotnet-sdk"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
        "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\S*mcr\\.microsoft\\.com\\/dotnet\\/aspnet:(?<currentValue>\\d+(\\.\\d+)?(\\.\\d+)?).*",
        "\\S*mcr\\.microsoft\\.com\\/dotnet\\/runtime:(?<currentValue>\\d+(\\.\\d+)?(\\.\\d+)?).*",
        "\\S*mcr\\.microsoft\\.com\\/dotnet\\/runtime-deps:(?<currentValue>\\d+(\\.\\d+)?(\\.\\d+)?).*"
      ],
      "datasourceTemplate": "dotnet-version",
      "packageNameTemplate": "dotnet-runtime"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
        "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\S*mcr\\.microsoft\\.com\\/dotnet\\/sdk:(?<currentValue>\\d+(\\.\\d+)?(\\.\\d+)?).*"
      ],
      "datasourceTemplate": "dotnet-version",
      "packageNameTemplate": "dotnet-sdk"
    },
    {
      // Track client-side libraries pinned in Microsoft LibMan (libman.json) manifests. Renovate has no native
      // LibMan manager (proposed: https://github.com/renovatebot/renovate/discussions/46445) and no datasource for
      // the "jsdelivr"/"unpkg" LibMan providers either, so this is a deliberate, TEMPORARY workaround, not a
      // correct implementation - remove it once/if the discussion above results in native support.
      //
      // The regex below matches every `"library": "<name>@<version>"` entry in libman.json, regardless of the
      // sibling "provider"/"defaultProvider" field, and always resolves versions via the npm datasource. That is
      // accurate for the "jsdelivr"/"unpkg" providers (they mirror npm packages under the same name), but it is
      // only an APPROXIMATION for the "cdnjs" provider: npm's published versions are not guaranteed to match what's
      // actually available on cdnjs. As of 2026-09-24 this affects exactly two entries across our repos - spin.js
      // (ThisIsYourLife) and font-awesome (BlazorFotoManager) - both verified to exist under an identical name on
      // npm today, but that alignment isn't guaranteed to hold for future versions. Do not extend this pattern to
      // a library that has no identically-named npm package. The companion packageRule above disables automerge
      // for every update this manager produces, so a human confirms the version is actually restorable via
      // "libman restore" (which queries the REAL provider, not npm) before it gets merged.
      //
      // "filesystem"-provider entries reference a local path instead of "name@version" and are not matched here,
      // which is the intended behavior (there is no version to track for those).
      "customType": "regex",
      "description": "LibMan libraries, declared as \"<name>@<version>\" in libman.json, resolved via npm as an approximation (see comment above) until Renovate has native LibMan support.",
      "managerFilePatterns": [
        "/(^|/)libman\\.json$/"
      ],
      "matchStrings": [
        "\"library\"\\s*:\\s*\"(?<depName>.+)@(?<currentValue>[^@\"]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
